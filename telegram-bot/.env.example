# ── Zaroori ──────────────────────────────────────────────────────
# @BotFather se token lo (/newbot)
BOT_TOKEN=123456789:AAF_your_bot_token_here

# Apna Telegram user ID ( @userinfobot se pata karo ) — multiple ho to comma se
ADMIN_IDS=123456789

# ── Optional (defaults ache hain) ────────────────────────────────
# DATABASE_PATH=data/bot.db
# SIGNUP_BONUS=50        # naye user ko points
# REFERRAL_BONUS=25      # per referral
# DAILY_BONUS=10         # rozana bonus
# MIN_PAYOUT=5           # min points per join
# MAX_PAYOUT=50          # max points per join
# FEE_PERCENT=20         # group owner par fee %
# MAX_GROUPS_PER_USER=5
# LEAVE_CHECK_HOURS=72   # itne ghante tak joins re-verify hote hain
