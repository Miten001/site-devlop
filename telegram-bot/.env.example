# ── Required ─────────────────────────────────────────────────────
# Get a token from @BotFather (/newbot)
BOT_TOKEN=123456789:AAF_your_bot_token_here

# Your Telegram user ID (find it with @userinfobot) — comma separated for many
ADMIN_IDS=123456789

# ── Optional (production defaults) ─────────────────────────────
# DATABASE_PATH=data/bot.db
# SIGNUP_BONUS=0         # signup bonus disabled
# REFERRAL_BONUS=25      # the only bonus
# DAILY_BONUS=0          # Daily Bonus menu disabled
# MIN_PAYOUT=5           # min points per completion
# MAX_PAYOUT=50          # max points per completion
# FEE_PERCENT=0          # only the payout is charged to the owner
# MAX_GROUPS_PER_USER=0  # 0 = unlimited tasks per user
# VIEW_TIMER_SECONDS=30
# FEATURED_LINK=https://t.me/flex_fam
# FEATURED_PAYOUT=10
# FEATURED_RESHOW_DAYS=2
# LEAVE_CHECK_HOURS=72   # group/channel re-verify window
# DEAD_TASK_SKIP_LIMIT=15  # consecutive skips (0 completions) => auto-pause + strike
# DEAD_TASK_MAX_STRIKES=3  # strikes before every task of the owner is paused
